CLOVER_MERCHANT_ID=
# Genuine OAuth access_token -- NOT the merchant dashboard's own "Platform
# API" token, confirmed that one doesn't work for these calls. See
# web/app/api/webhooks/clover-oauth-capture/route.ts for the auth flow.
CLOVER_API_TOKEN=
CLOVER_ENVIRONMENT=sandbox

# Paid tier only -- see root CLAUDE.md's "Product images" section for the
# licensing basis before using this for anything beyond the free/trial tier.
FRAGANTY_API_KEY=
