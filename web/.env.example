# Supabase transaction pooler connection string (port 6543). See lib/db.ts.
DATABASE_URL=

# --- Clover: server-side (never exposed to the browser) --------------------
CLOVER_MERCHANT_ID=
# Genuine OAuth access_token -- NOT the merchant dashboard's own "Platform
# API" token, confirmed that one doesn't work for these calls. See
# app/api/webhooks/clover-oauth-capture/route.ts for the auth flow, and
# lib/clover.ts's file comment for the host/auth facts confirmed live.
CLOVER_API_TOKEN=
CLOVER_ENVIRONMENT=sandbox

# --- Clover: OAuth app credentials (needed to run the code-capture flow) ---
CLOVER_APP_ID=
CLOVER_APP_SECRET=

# Clover Platform webhook receiver (app/api/webhooks/clover/route.ts).
# Static header value (X-Clover-Auth) -- this is the app's own App Secret,
# not a computed signature the way Square's webhook check was.
CLOVER_WEBHOOK_AUTH_CODE=

# --- Clover: Remote Pay Cloud (pays live on the kiosk's Flex device) -------
# No card form exists in this app at all -- see lib/clover-connector.ts.
# CLOVER_REMOTE_APPLICATION_ID is a self-declared identifier for this
# integration (not issued by Clover), kept stable once chosen.
CLOVER_REMOTE_APPLICATION_ID=
CLOVER_KIOSK_DEVICE_ID=
