# Supabase transaction pooler connection string (port 6543). See lib/db.ts.
DATABASE_URL=

# --- Square: server-side (never exposed to the browser) --------------------
SQUARE_ACCESS_TOKEN=your_sandbox_access_token_here
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=

# Square webhook receiver (app/api/webhooks/square/route.ts).
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# --- Square: Web Payments SDK (shipped to the browser) ---------------------
# Safe to expose -- these identify the app/location, they don't authorize
# anything on their own. Must match SQUARE_APPLICATION_ID / SQUARE_LOCATION_ID
# / SQUARE_ENVIRONMENT above.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
